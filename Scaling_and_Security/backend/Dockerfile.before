# BEFORE hardening - only used to produce the "before" Trivy scan.
# Full Debian image (hundreds of extra packages) and the container runs as root.
FROM python:3.12

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

EXPOSE 8080
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "--access-logfile", "-", "app:app"]
